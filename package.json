{
  "name": "micelio",
  "version": "0.4.1",
  "description": "Secondo cervello distribuito peer-to-peer per gli strumenti AI di un team di sviluppo",
  "private": true,
  "type": "commonjs",
  "license": "UNLICENSED",
  "bin": {
    "micelio": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build -w ui",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:docker": "bash test/e2e/docker/scenario.sh",
    "eval:ingest": "vitest run --config vitest.eval.config.ts",
    "demo": "node scripts/demo-team.js",
    "demo:grande": "node scripts/demo-large.js",
    "desktop": "npm run start -w desktop",
    "test:ui": "npm test -w ui",
    "package:win": "node scripts/package-win.js",
    "package:linux": "node scripts/package-linux.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/serve-static": "^5.0.5",
    "autobase": "^7.28.2",
    "b4a": "^1.9.0",
    "blind-pairing": "^2.3.1",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.15.0",
    "hyperbee": "^2.27.3",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "officeparser": "^8.1.1",
    "protomux": "^3.13.0",
    "protomux-wakeup": "^2.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "z32": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "hyperdht": "^6.34.1",
    "typescript": "5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "ui",
    "desktop"
  ],
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
